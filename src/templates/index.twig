{# @var craft \craft\web\twig\variables\CraftVariable #}
{% extends "_layouts/cp" %}

{% import "_includes/forms" as _forms %}

{% set title = 'Import' %}

{#% set tabs = {
    url: {
        label: 'Import from URL',
        url: cpUrl('import/url')
    },
    file: {
        label: 'Import from file',
        url: cpUrl('import/file')
    }
} %#}

{#  % set selectedTab = actionSlug ?? 'url' %#}

{% set content %}

    <form method="post" accept-charset="UTF-8" enctype="multipart/form-data">

        {{ actionInput('escape-exportimport/import') }}
        {{ hiddenInput('siteId', currentSite.id) }}
        {{ csrfInput() }}

        <div>

            {% if actionSlug == 'file' %}

                <h2>Import elements from JSON export</h2>

                {{ _forms.fileField({
                    label: 'JSON file',
                    name: 'elementsJsonFile',
                }) }}

            {% else %}

                <h2>Import elements from URL</h2>

                {{ _forms.textField({
                    label: 'Import URL',
                    name: 'elementsJsonUrl',
                    type: 'url'
                }) }}
            {% endif %}

            <hr />

            {{ _forms.lightswitchField({
                label: 'Include assets',
                instructions: 'Attempt to import related assets (images, etc) from imported elements',
                name: 'includeAssets',
                on: includeAssets ?? true
            }) }}

            {{ _forms.lightswitchField({
                label: 'Status for imported elements',
                name: 'enableElements',
                offLabel: 'Disabled',
                onLabel: 'Enabled',
                on: enableElements ?? false
            }) }}

            {% set config = craft.app.config.configFromFile('escape-exportimport') %}
            {% set exportableSections = config.exportableSections|default([]) %}
            {% set sections = craft.app.entries.allSections|filter(section => section.handle in exportableSections) %}

            {% if sections|length %}
                {{ _forms.selectField({
                    label: 'Target section',
                    name: 'targetSectionId',
                    instructions: 'By default, imported entries will be saved to the same section they were exported from. If you want imported entries saved to a different section, select it below.',
                    warning: 'Field layouts can vary between sections. If an imported element uses a field that is not available in the selected target section, any data in that field will not be imported.',
                    options: [{ value: '', label: 'Same as exported (default)' }]|merge(sections|map(section => {
                        value: section.id,
                        label: section.name
                    }))
                }) }}
            {% endif %}

            <div class="btngroup">
                <button type="submit" class="btn submit">Import</button>
            </div>

        </div>

    </form>

{% endset %}

